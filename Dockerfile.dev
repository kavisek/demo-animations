# Development image: runs `next dev` with hot reloading.
# The source code is bind-mounted by compose.yaml, so only the dependencies are baked in.
FROM node:22-alpine

WORKDIR /app
RUN chown node:node /app
USER node

# Install dependencies first so this layer is cached until package*.json changes
COPY --chown=node:node frontend_tailwind/package.json frontend_tailwind/package-lock.json ./
RUN --mount=type=cache,target=/home/node/.npm,uid=1000,gid=1000 npm ci

# Pre-create .next so the anonymous volume compose mounts here is owned by `node`
RUN mkdir -p .next

EXPOSE 3000
CMD ["npm", "run", "dev", "--", "--hostname", "0.0.0.0", "--port", "3000"]
